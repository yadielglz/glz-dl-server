{
  "name": "glz-dl-server",
  "main": "src/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-01-15",
  "routes": [
    {
      "pattern": "dl.glztech.com",
      "zone_name": "glztech.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "glz-files"
    }
  ],
  "kv_namespaces": [
    {
      "id": "755394be98ed422c9f15da9b7e7a3cc5",
      "binding": "LINKS"
    }
  ]
}